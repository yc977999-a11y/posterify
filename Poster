# Enhance image function
def enhance_image(img):
    img = ImageEnhance.Color(img).enhance(1.5)       # Boost color
    img = ImageEnhance.Contrast(img).enhance(1.3)    # Boost contrast
    img = ImageEnhance.Sharpness(img).enhance(2.0)   # Boost sharpness
    return img

